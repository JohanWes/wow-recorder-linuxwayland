{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warcraft Recorder",
  "version": "8.0.0",
  "identifier": "com.warcraftrecorder.linuxwayland",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Warcraft Recorder",
        "width": 1584,
        "height": 918,
        "decorations": false
      }
    ],
    "security": {}
  },
  "bundle": {
    "active": true,
    "targets": ["appimage"],
    "icon": ["icons/icon.png"]
  }
}
