{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warcraft Recorder",
  "version": "0.1.0",
  "identifier": "com.warcraftrecorder.linuxwayland",
  "build": {
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Warcraft Recorder",
        "width": 1584,
        "height": 918,
        "decorations": false
      }
    ],
    "security": {
      "assetProtocol": {
        "enable": true,
        "scope": []
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/icon.png"]
  }
}
