{
  "compilerOptions": {
    "incremental": true,
    "target": "es2022",
    "module": "ESNext",
    "lib": ["dom", "es2022"],
    "jsx": "react-jsx",
    "strict": true,
    "sourceMap": true,
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "allowJs": true,
    "outDir": "dist",
    "baseUrl": "./src",
    "paths": {
      "main/*": ["main/*"], "config/*": ["config/*"],
      "localisation/*": ["localisation/*"], "types/*": ["types/*"],
      "renderer/*": ["renderer/*"], "parsing/*": ["parsing/*"]
    },
  },
  "include": ["src/renderer", "src/config", "src/localisation", "src/types", "src/main/types.ts", "src/main/constants.ts", "src/main/keystone.ts", "src/main/obsEnums.ts", "src/parsing/logutils.ts", "vite.config.ts"],
  "exclude": ["src-tauri"]
}
