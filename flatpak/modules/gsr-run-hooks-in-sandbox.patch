-        args[0] = "flatpak-spawn";
-        args[1] = "--host";
-        args[2] = "--";
-        args[3] = script_file_full;
-        args[4] = video_file;
-        args[5] = type;
-        args[6] = NULL;
-    } else {
-        args[0] = script_file_full;
-        args[1] = video_file;
-        args[2] = type;
-        args[3] = NULL;
-    }
