  "keywords": [
    "world",
    "of",
    "warcraft",
    "screen",
    "recorder"
  ],
  "homepage": "https://github.com/JohanWes/wow-recorder-linuxwayland",
  "bugs": {
    "url": "https://github.com/JohanWes/wow-recorder-linuxwayland/issues"
