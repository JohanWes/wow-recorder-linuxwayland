    "react-tag-autocomplete": "^7.5.0",
    "react-tailwindcss-datepicker": "^1.7.3",
    "screenfull": "^6.0.2",
    "tailwind-merge": "^2.5.2",
    "tailwindcss-animate": "^1.0.7"
