# Maintainer: (autogenerated by CI)

pkgname=warcraft-recorder-linux
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Warcraft Recorder (Linux AppImage) — pacman repo build'
arch=('x86_64')
url='https://github.com/@GITHUB_OWNER@/@GITHUB_REPO@'
license=('custom')
depends=(
  'gpu-screen-recorder'
  'pipewire'
  'xdg-desktop-portal'
  'fuse2'
)
optdepends=(
  'xdg-desktop-portal-hyprland: portal backend (Hyprland)'
  'xdg-desktop-portal-kde: portal backend (KDE)'
  'xdg-desktop-portal-gnome: portal backend (GNOME)'
  'xdg-desktop-portal-wlr: portal backend (wlroots)'
)
provides=('warcraft-recorder-linux')
conflicts=('warcraft-recorder-linux')
options=('!strip')

source=(
  "WarcraftRecorder.AppImage"
  "${pkgname}.desktop"
  "${pkgname}.sh"
  "icon.png"
)
sha256sums=(
  '@APPIMAGE_SHA256@'
  '@DESKTOP_SHA256@'
  '@WRAPPER_SHA256@'
  '@ICON_SHA256@'
)

package() {
  install -Dm755 "WarcraftRecorder.AppImage" "${pkgdir}/opt/${pkgname}/WarcraftRecorder.AppImage"
  install -Dm755 "${pkgname}.sh" "${pkgdir}/usr/bin/${pkgname}"
  ln -s "/usr/bin/${pkgname}" "${pkgdir}/usr/bin/warcraftrecorder_linux"

  install -Dm644 "icon.png" "${pkgdir}/usr/share/pixmaps/${pkgname}.png"
  install -Dm644 "${pkgname}.desktop" "${pkgdir}/usr/share/applications/${pkgname}.desktop"
}
