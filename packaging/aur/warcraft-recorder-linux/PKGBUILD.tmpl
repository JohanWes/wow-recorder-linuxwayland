# Maintainer: (autogenerated by CI from this template)

pkgname=warcraft-recorder-linux
pkgver=@PKGVER@
pkgrel=1
pkgdesc='Warcraft Recorder (Linux AppImage) — fork nightly build'
arch=('x86_64')
url='https://github.com/@GITHUB_OWNER@/@GITHUB_REPO@'
license=('custom')
depends=()
optdepends=(
  'gpu-screen-recorder: Wayland recording backend'
  'pipewire: screen capture/audio routing'
  'xdg-desktop-portal: portal-based screen capture'
  'fuse2: run AppImages via FUSE (else use --appimage-extract-and-run)'
)
provides=('warcraft-recorder-linux')
conflicts=('warcraft-recorder-linux')
options=('!strip')

_appimage_name="WarcraftRecorder-nightly.AppImage"
_tag="nightly"

source=(
  "${_appimage_name}::https://github.com/@GITHUB_OWNER@/@GITHUB_REPO@/releases/download/${_tag}/${_appimage_name}"
  "${pkgname}.desktop"
  "${pkgname}.sh"
)
sha256sums=(
  '@APPIMAGE_SHA256@'
  '@DESKTOP_SHA256@'
  '@WRAPPER_SHA256@'
)

package() {
  install -Dm755 "${_appimage_name}" "${pkgdir}/opt/${pkgname}/WarcraftRecorder.AppImage"
  install -Dm755 "${pkgname}.sh" "${pkgdir}/usr/bin/${pkgname}"
  ln -s "/usr/bin/${pkgname}" "${pkgdir}/usr/bin/warcraftrecorder_linux"
  install -Dm644 "${pkgname}.desktop" "${pkgdir}/usr/share/applications/${pkgname}.desktop"
}
